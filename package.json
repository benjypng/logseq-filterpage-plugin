{
  "name": "logseq-filterpage-plugin",
  "author": "benjypng",
  "description": "Filer the current page based on tags that you want to include or exclude.",
  "license": "MIT",
  "logseq": {
    "id": "logseq-filterpage-plugin",
    "title": "logseq-filterpage-plugin",
    "icon": "./icon.svg",
    "main": "dist/index.html"
  },
  "scripts": {
    "dev": "bunx vite",
    "build": "bunx vite build",
    "prepare": "husky",
    "lint:precommit": "echo \"Running biome\" && bunx biome check . --write && echo \"Running tsc\" && tsc --noEmit"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/github",
        {
          "assets": [
            "logseq-filterpage-plugin.zip"
          ]
        }
      ]
    ]
  },
  "dependencies": {
    "@logseq/libs": "^0.0.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "husky": "^9.1.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-logseq": "^1.1.2",
    "vite-tsconfig-paths": "^5.0.1"
  }
}
