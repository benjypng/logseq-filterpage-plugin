{
  "name": "logseq-filterpage-plugin",
  "author": "benjypng",
  "description": "Filer the current page based on tags that you want to include or exclude.",
  "license": "MIT",
  "logseq": {
    "id": "logseq-filterpage-plugin",
    "title": "logseq-filterpage-plugin",
    "icon": "./icon.svg",
    "main": "dist/index.html"
  },
  "scripts": {
    "dev": "bunx vite",
    "build": "bunx vite build",
    "prepare": "husky",
    "lint:precommit": "echo \"Running biome\" && bunx biome check . --write && echo \"Running tsc\" && tsc --noEmit"
  },
  "release": {
    "branches": ["main"],
    "plugins": [
      [
        "@semantic-release/github",
        {
          "assets": ["logseq-filterpage-plugin.zip"]
        }
      ]
    ]
  },
  "dependencies": {
    "@logseq/libs": "^0.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-logseq": "^1.1.2",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
